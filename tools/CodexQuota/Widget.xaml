<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 额度" Width="360" Height="224" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="True" FontFamily="Microsoft YaHei UI" FontSize="12" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBlock">
   <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
   <Setter Property="FontSize" Value="12" />
   <Setter Property="LineHeight" Value="18" />
   <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
   <Setter Property="VerticalAlignment" Value="Center" />
   <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
 </Window.Resources>
 <Border x:Name="Root" Background="#F21B2130" CornerRadius="12" BorderBrush="#47536B" BorderThickness="1" Padding="8,8,8,0">
  <Grid x:Name="LayoutRoot">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /></Grid.RowDefinitions><Grid x:Name="QuotaArea" Background="Transparent" Margin="0,0,0,0" MinHeight="28"><StackPanel x:Name="Details">
   <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="TitleLabel" Text="Codex 额度" Foreground="#F0F3FA" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" />
   <TextBlock x:Name="Updated" Foreground="#96A3BC" Margin="6,0,0,0" Grid.Column="1" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
  </Grid><Grid x:Name="HourInfo"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="12" /><ColumnDefinition Width="48" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock x:Name="HourLabel" Foreground="#D3DAE8" TextWrapping="NoWrap" FontWeight="Bold" />
    <TextBlock Text="|" Grid.Column="1" Foreground="#96A3BC" />
    <TextBlock x:Name="HourValue" Grid.Column="2" TextWrapping="NoWrap" FontSize="13" FontWeight="Bold" />
    <TextBlock Text="|" Grid.Column="3" Foreground="#96A3BC" />
    <TextBlock x:Name="HourReset" Grid.Column="4" TextWrapping="NoWrap" FontSize="13" FontWeight="Bold" />
   </Grid>
   <ProgressBar x:Name="HourBar" Height="17" Margin="0,2,0,2" Maximum="100" BorderThickness="0" />
   <ProgressBar x:Name="HourTimeBar" Height="5" Margin="0,0,0,8" Maximum="100" BorderThickness="0" />
   <Grid x:Name="WeekInfo"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="12" /><ColumnDefinition Width="48" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock x:Name="WeekLabel" Foreground="#D3DAE8" TextWrapping="NoWrap" FontWeight="Bold" />
    <TextBlock Text="|" Grid.Column="1" Foreground="#96A3BC" />
    <TextBlock x:Name="WeekValue" Grid.Column="2" TextWrapping="NoWrap" FontSize="13" FontWeight="Bold" />
    <TextBlock Text="|" Grid.Column="3" Foreground="#96A3BC" />
    <TextBlock x:Name="WeekReset" Grid.Column="4" TextWrapping="NoWrap" FontSize="13" FontWeight="Bold" />
   </Grid>
   <ProgressBar x:Name="WeekBar" Height="17" Margin="0,2,0,2" Maximum="100" BorderThickness="0" />
   <ProgressBar x:Name="WeekTimeBar" Height="5" Maximum="100" BorderThickness="0" />
   </StackPanel>
  <Grid x:Name="Compact" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="21" /><RowDefinition Height="7" /><RowDefinition Height="6" /><RowDefinition Height="21" /><RowDefinition Height="7" /></Grid.RowDefinitions>
   <TextBlock Text="5h" Foreground="#D3DAE8" FontSize="12" HorizontalAlignment="Left" Margin="6,0,0,0" TextWrapping="NoWrap" Panel.ZIndex="2" FontWeight="Bold" x:Name="CompactHourLabel" />
   <ProgressBar x:Name="CompactHourBar" Height="19" Maximum="100" BorderThickness="0" />
   <ProgressBar x:Name="CompactHourTimeBar" Grid.Row="0" Grid.RowSpan="2" Height="5" Margin="0,22,0,0" Maximum="100" BorderThickness="0" VerticalAlignment="Top" />
   <TextBlock x:Name="CompactHourReset" Visibility="Collapsed" />
   <TextBlock x:Name="CompactWeekLabel" Text="周" Grid.Row="3" Foreground="#D3DAE8" FontSize="12" HorizontalAlignment="Left" Margin="6,0,0,0" TextWrapping="NoWrap" Panel.ZIndex="2" FontWeight="Bold" />
   <ProgressBar x:Name="CompactWeekBar" Grid.Row="3" Height="19" Maximum="100" BorderThickness="0" />
   <ProgressBar x:Name="CompactWeekTimeBar" Grid.Row="3" Grid.RowSpan="2" Height="5" Margin="0,22,0,0" Maximum="100" BorderThickness="0" VerticalAlignment="Top" />
   <TextBlock x:Name="CompactWeekReset" Visibility="Collapsed" />
  </Grid>
  <TextBlock x:Name="EmptyUsage" Text="暂无额度数据" Margin="0,30,0,6" Visibility="Collapsed" /></Grid><Grid x:Name="Toolbar" Grid.Row="1" Background="Transparent" Margin="0,-2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="AppearanceButton" Width="24" Height="18" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" ToolTip="外观设置" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Bottom">
     <Viewbox Width="13" Height="13"><Canvas Width="20" Height="20"><Path Data="M 8,12 L 15,3 Q 17,1 18,3 L 11,14 Z M 8,12 Q 3,11 3,16 L 2,18 Q 9,19 11,14" Stroke="#AAB5CA" StrokeThickness="1.2" StrokeLineJoin="Round" /></Canvas></Viewbox>
    </Button>
    <Button x:Name="LockButton" Width="24" Height="18" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Bottom" Background="Transparent" BorderThickness="0" Grid.Column="2" HorizontalAlignment="Center">
     <Viewbox Width="13" Height="13"><Canvas Width="20" Height="20">
      <Path x:Name="LockGlyph" Data="M 6,10 V 7 A 4,4 0 0 1 14,7 V 10 M 3,10 H 17 V 17 H 3 Z" Stroke="#AAB5CA" StrokeThickness="1.2" />
     </Canvas></Viewbox>
    </Button>
    <Button x:Name="LanguageButton" Width="24" Height="18" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Bottom" Background="Transparent" Foreground="#AAB5CA" BorderThickness="0" ToolTip="语言" Grid.Column="1" HorizontalAlignment="Center">
     <Viewbox Width="13" Height="13"><Canvas Width="20" Height="20">
      <Ellipse Width="14" Height="14" Canvas.Left="3" Canvas.Top="3" Stroke="#AAB5CA" StrokeThickness="1.2" />
      <Ellipse Width="6" Height="14" Canvas.Left="7" Canvas.Top="3" Stroke="#AAB5CA" StrokeThickness="1" />
      <Line X1="3" Y1="10" X2="17" Y2="10" Stroke="#AAB5CA" StrokeThickness="1" />
      <Line X1="3" Y1="5.5" X2="17" Y2="5.5" Stroke="#AAB5CA" StrokeThickness="0.8" />
      <Line X1="3" Y1="14.5" X2="17" Y2="14.5" Stroke="#AAB5CA" StrokeThickness="0.8" />
     </Canvas></Viewbox>
    </Button>
    <Button x:Name="RefreshButton" Width="24" Height="18" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Bottom" Background="Transparent" Foreground="#7EE2BA" BorderThickness="0" ToolTip="主动查询最新账户额度" Grid.Column="3" HorizontalAlignment="Center">
     <Viewbox Width="13" Height="13"><Canvas Width="20" Height="20">
      <Path Data="M 15,5 A 7,7 0 1 0 17,10 M 15,3 L 15,6 L 11,6" Stroke="#7EE2BA" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
     </Canvas></Viewbox>
    </Button>
    <Button x:Name="CloseButton" Width="24" Height="18" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Bottom" Background="Transparent" Foreground="#AAB5CA" BorderThickness="0" ToolTip="关闭悬浮窗" Grid.Column="4" Margin="0" HorizontalAlignment="Center">
     <Viewbox Width="13" Height="13"><Canvas Width="20" Height="20">
      <Path Data="M 3,3 L 17,17 M 17,3 L 3,17" Stroke="#AAB5CA" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
     </Canvas></Viewbox>
    </Button>
    </Grid></Grid>
 </Border>
</Window>